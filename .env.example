# Registration backend (Supabase). Browser-safe values ONLY.
# VITE_* variables are bundled into public JavaScript — never put the
# service_role key or any other secret here. The Edge Functions read their
# own secrets (SUPABASE_SERVICE_ROLE_KEY, QR_VERIFY_BASE_URL, RESEND_API_KEY…)
# from Supabase function secrets, not from this file.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<public-anon-key>
